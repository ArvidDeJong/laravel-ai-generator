# At least one API key. Run "php artisan ai-generator:install" to set these up.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Which provider writes, which one makes images, and which ones take over on a failure
AI_GENERATOR_DRIVER=openai
AI_GENERATOR_IMAGE_DRIVER=
AI_GENERATOR_FALLBACKS=

# Optional - models per provider
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
XAI_MODEL=grok-4.7
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Optional - OpenAI settings
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=45

# Optional - Content defaults
AI_GENERATOR_LANGUAGE=nl
AI_GENERATOR_TONE=informal
AI_GENERATOR_LEVEL=general
AI_GENERATOR_MAX_WORDS=900

# Optional - MCP server (needs laravel/mcp)
AI_GENERATOR_MCP=true
