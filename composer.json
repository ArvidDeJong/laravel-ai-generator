{
    "name": "darvis/laravel-ai-generator",
    "description": "AI content generation service for Laravel applications with OpenAI support",
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/laravel-ai-generator/",
    "keywords": [
        "laravel",
        "ai",
        "openai",
        "content-generation",
        "seo",
        "gpt",
        "laravel-boost"
    ],
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/laravel-ai-generator/issues",
        "source": "https://github.com/ArvidDeJong/laravel-ai-generator",
        "docs": "https://arviddejong.github.io/laravel-ai-generator/"
    },
    "require": {
        "php": "^8.2",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\LaravelAiGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\LaravelAiGenerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest tests",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\LaravelAiGenerator\\AiGeneratorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
